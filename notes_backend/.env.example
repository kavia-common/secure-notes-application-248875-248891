# Backend configuration (notes_backend)
ENVIRONMENT=development
APP_NAME="Secure Notes API"

# CORS: comma-separated list of allowed origins (frontend URL)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Database (must match notes_database exported env vars)
POSTGRES_URL=postgresql://localhost:5000/myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp
POSTGRES_PORT=5000

# JWT
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXP_MINUTES=1440
